// ESME TENDERA — modèle de données
//
// Le schéma couvre le cycle de vie complet d'une consultation : veille,
// identification, DCE, matching, décision Go/No Go, préparation de la réponse,
// contrôle qualité, dépôt, négociation et résultat.
//
// Principe de traçabilité : tout fait analysé par la plateforme porte sa source
// (document + page quand elle est connue) et tout changement d'état est journalisé.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Utilisateurs, rôles et audit
// ---------------------------------------------------------------------------

enum Role {
  ADMINISTRATEUR
  RESPONSABLE_AO
  REDACTEUR
  EXPERT_PEDAGOGIQUE
  RELECTEUR
  LECTEUR
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(LECTEUR)
  jobTitle     String?
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ownedTenders     Tender[]          @relation("TenderOwner")
  assignments      Assignment[]
  tasks            Task[]            @relation("TaskAssignee")
  auditEvents      AuditEvent[]
  comments         DocumentComment[]
  decisions        Decision[]
  notifications    Notification[]
  documentVersions DocumentVersion[]
  negotiationItems NegotiationItem[]

  @@index([role])
}

/// Journal d'audit : qui a fait quoi, quand, sur quelle entité.
model AuditEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Acteur non humain : "systeme", "veille", "moteur-ia".
  actor     String   @default("utilisateur")
  action    String
  entity    String
  entityId  String
  summary   String
  /// Détail structuré : valeurs avant/après, paramètres, etc.
  payload   Json?

  tenderId String?
  tender   Tender? @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([entity, entityId])
  @@index([tenderId, createdAt])
}

// ---------------------------------------------------------------------------
// Référentiel pédagogique — catalogue ESME, formations voisines, Groupe IONIS
// ---------------------------------------------------------------------------

enum TrainingOrigin {
  /// Priorité 1 : formation du catalogue ESME Executive Education.
  CATALOGUE_ESME
  /// Priorité 2 : formation voisine, adaptable ou à concevoir sur mesure.
  VOISINE
  /// Priorité 3 : compétence portée par un autre établissement du Groupe IONIS.
  IONIS
}

model TrainingDomain {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  longName  String?
  intro     String?
  /// Ordre d'affichage dans le référentiel.
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainings Training[]
}

/// Une fiche du référentiel pédagogique.
model Training {
  id       String          @id @default(cuid())
  origin   TrainingOrigin  @default(CATALOGUE_ESME)
  /// Référence catalogue, ex. « PV 100 ».
  code     String
  slug     String          @unique
  title    String
  domainId String?
  domain   TrainingDomain? @relation(fields: [domainId], references: [id], onDelete: SetNull)
  theme    String?
  subTheme String?

  /// Objectif général de la fiche.
  objective     String?
  /// Public cible tel que publié.
  audience      String?
  objectives    String[] @default([])
  prerequisites String[] @default([])
  methods       String[] @default([])
  highlights    String[] @default([])
  /// Compétences visées, normalisées pour le matching.
  skills        String[] @default([])
  /// Compétences connexes / adjacentes mobilisables.
  relatedSkills String[] @default([])
  keywords      String[] @default([])
  /// Codes CPV indicatifs rattachés à la formation.
  cpvCodes      String[] @default([])

  duration      String?
  hours         Int?
  modality      String?
  /// Présentiel / distanciel / hybride.
  deliveryModes String[] @default([])
  certification String?
  intraOnly     Boolean  @default(false)

  /// Programme détaillé : [{ heading, items[] }].
  programme  Json?
  evaluation String?

  /// Traçabilité de la source.
  sourceDocument String?
  catalogPage    Int?
  sourceUrl      String?

  /// Établissement IONIS porteur (origin = IONIS).
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  version   Int      @default(1)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches TrainingMatch[]

  @@unique([origin, code])
  @@index([origin, archived])
  @@index([domainId])
}

/// Établissement du Groupe IONIS et compétences mobilisables.
model Institution {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  shortName   String?
  description String?
  domains     String[] @default([])
  skills      String[] @default([])
  programmes  String[] @default([])
  audiences   String[] @default([])
  modalities  String[] @default([])
  /// Modalités de coopération envisageables (co-traitance, sous-traitance…).
  cooperation String?
  sourceUrl   String?
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trainings Training[]
}

// ---------------------------------------------------------------------------
// Veille — sources et exécutions
// ---------------------------------------------------------------------------

enum ConnectorStatus {
  /// Connecteur implémenté et joignable.
  OPERATIONNEL
  /// Implémenté mais injoignable depuis cet environnement (réseau, compte requis).
  INDISPONIBLE
  /// Pas encore implémenté.
  A_IMPLEMENTER
  /// Désactivé par un administrateur.
  DESACTIVE
}

model SourceConnector {
  id          String          @id @default(cuid())
  key         String          @unique
  name        String
  baseUrl     String?
  description String?
  status      ConnectorStatus @default(A_IMPLEMENTER)
  /// Ce qu'il manque pour rendre le connecteur opérationnel.
  requirement String?
  enabled     Boolean         @default(false)
  /// Paramètres propres au connecteur (mots-clés, CPV, filtres).
  config      Json?
  lastRunAt   DateTime?
  lastError   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  runs    VeilleRun[]
  tenders Tender[]
}

enum RunStatus {
  EN_COURS
  SUCCES
  PARTIEL
  ECHEC
}

model VeilleRun {
  id            String          @id @default(cuid())
  connectorId   String
  connector     SourceConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  status        RunStatus       @default(EN_COURS)
  /// "planifiee" (7h Paris) ou "manuelle".
  trigger       String          @default("manuelle")
  startedAt     DateTime        @default(now())
  finishedAt    DateTime?
  fetched       Int             @default(0)
  created       Int             @default(0)
  updated       Int             @default(0)
  duplicates    Int             @default(0)
  rectificatifs Int             @default(0)
  errors        String[]        @default([])
  log           Json?

  @@index([connectorId, startedAt])
}

// ---------------------------------------------------------------------------
// Affaires (consultations)
// ---------------------------------------------------------------------------

enum PipelineStage {
  AO_IDENTIFIES
  MATCHING
  GO_NO_GO
  PREPARATION
  CONTROLE_QUALITE
  PRET_AU_DEPOT
  DEPOT_EFFECTUE
  NEGOCIATION
  ATTENTE_RESULTAT
  MARCHE_ATTRIBUE
  REJETE_NON_POURSUIVI
}

enum GoNoGoStatus {
  A_DECIDER
  GO
  NO_GO
}

enum OutcomeStatus {
  EN_ATTENTE
  ATTRIBUE
  REJETE
  ANNULE
  SANS_SUITE
  INFRUCTUEUX
}

enum DceStatus {
  /// Pas encore tenté.
  NON_TENTE
  /// Récupéré automatiquement.
  RECUPERE
  /// Déposé manuellement par un utilisateur.
  IMPORTE_MANUELLEMENT
  /// Échec de récupération : raison dans dceFailureReason.
  NON_RECUPERE
}

enum AmountKind {
  ESTIME
  MAXIMUM
  PAR_LOT
  GLOBAL
  NON_COMMUNIQUE
}

model Tender {
  id        String @id @default(cuid())
  /// Référence interne lisible, ex. « AO-2026-0042 ».
  reference String @unique

  title           String
  buyer           String
  buyerSiret      String?
  /// Numéro de consultation tel que publié par l'acheteur.
  consultationRef String?
  objectSummary   String?
  procedure       String?
  cpvCodes        String[] @default([])
  /// Nature du marché déclarée par l'acheteur : SERVICES, TRAVAUX, FOURNITURES.
  /// C'est elle qui distingue « marché de formation » de « travaux dans un
  /// centre de formation ».
  marketTypes     String[] @default([])
  lotLabel        String?

  publishedAt      DateTime?
  deadlineAt       DateTime?
  /// Durée du marché telle que publiée (texte libre).
  contractDuration String?
  renewals         String?
  executionPlace   String?
  region           String?
  department       String?
  /// Distanciel possible d'après les pièces.
  remoteEligible   Boolean?
  responseTerms    String?

  amountKind   AmountKind @default(NON_COMMUNIQUE)
  amountMinEur Decimal?   @db.Decimal(14, 2)
  amountMaxEur Decimal?   @db.Decimal(14, 2)
  amountNote   String?

  sourceConnectorId String?
  sourceConnector   SourceConnector? @relation(fields: [sourceConnectorId], references: [id], onDelete: SetNull)
  /// Identifiant de l'avis chez la source, sert à la déduplication.
  sourceNoticeId    String?
  sourceUrl         String?
  /// Avis rectificatifs rattachés.
  rectificatifs     Json?

  stage    PipelineStage @default(AO_IDENTIFIES)
  goNoGo   GoNoGoStatus  @default(A_DECIDER)
  outcome  OutcomeStatus @default(EN_ATTENTE)
  archived Boolean       @default(false)
  /// Donnée de démonstration : jamais confondue avec un avis réel.
  isDemo   Boolean       @default(false)

  dceStatus        DceStatus @default(NON_TENTE)
  dceFailureReason String?
  dceSourceUrl     String?

  ownerId String?
  owner   User?   @relation("TenderOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  /// Affaire créée pour un lot précis d'une consultation mère.
  parentId String?
  parent   Tender?  @relation("TenderLots", fields: [parentId], references: [id], onDelete: SetNull)
  children Tender[] @relation("TenderLots")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lots             Lot[]
  documents        Document[]
  analysis         TenderAnalysis?
  requirements     Requirement[]
  matchResult      MatchResult?
  decisions        Decision[]
  tasks            Task[]
  assignments      Assignment[]
  checklistItems   ChecklistItem[]
  responseDocs     ResponseDocument[]
  qualityReviews   QualityReview[]
  submission       Submission?
  negotiationItems NegotiationItem[]
  result           TenderResult?
  auditEvents      AuditEvent[]
  notifications    Notification[]
  pricingLines     PricingLine[]

  @@index([stage, archived])
  @@index([deadlineAt])
  @@index([sourceConnectorId, sourceNoticeId])
}

model Lot {
  id              String     @id @default(cuid())
  tenderId        String
  tender          Tender     @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  number          String
  title           String
  description     String?
  cpvCodes        String[]   @default([])
  amountKind      AmountKind @default(NON_COMMUNIQUE)
  amountMinEur    Decimal?   @db.Decimal(14, 2)
  amountMaxEur    Decimal?   @db.Decimal(14, 2)
  /// Affaire dédiée créée pour ce lot, le cas échéant.
  spawnedTenderId String?
  relevant        Boolean    @default(true)

  /// Affinité du lot avec le référentiel, calculée lot par lot.
  ///
  /// Le score de l'affaire mélange tous les lots : un accord-cadre de
  /// formation à douze lots dont deux relèvent du catalogue obtient une note
  /// moyenne qui ne décrit aucun des deux. Ces colonnes disent ce qui se joue
  /// lot par lot — c'est à ce niveau que l'on se positionne.
  scoreCatalogue Float?
  scoreVoisines  Float?
  scoreGlobal    Float?
  nature         TenderNature?
  natureLabel    String?
  /// Fiches du référentiel les plus proches, libellés figés pour l'affichage.
  matchTitles    String[]      @default([])
  matchedAt      DateTime?

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([tenderId, number])
}

// ---------------------------------------------------------------------------
// Documents : pièces du DCE, base de connaissances, documents de réponse
// ---------------------------------------------------------------------------

enum DocumentKind {
  RC
  CCTP
  CCAP
  AE
  BPU
  DPGF
  DQE
  CADRE_MEMOIRE
  DC1
  DC2
  DC4
  ANNEXE
  ATTESTATION
  REGLEMENT_CONSULTATION_ANNEXE
  AVIS
  AUTRE
}

enum DocumentScope {
  /// Pièce du dossier de consultation.
  DCE
  /// Pièce produite par ESME en réponse.
  REPONSE
  /// Document de la base de connaissances.
  CONNAISSANCE
}

model Document {
  id       String  @id @default(cuid())
  tenderId String?
  tender   Tender? @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  scope          DocumentScope @default(DCE)
  kind           DocumentKind  @default(AUTRE)
  /// Confiance de la classification automatique, 0 à 1.
  kindConfidence Float         @default(0)
  fileName       String
  mimeType       String?
  sizeBytes      Int?
  /// Chemin relatif dans le stockage documentaire.
  storagePath    String?
  /// Empreinte SHA-256, sert à la déduplication.
  sha256         String?
  /// Archive d'origine quand le fichier provient d'un ZIP.
  fromArchive    String?

  /// Texte extrait, page par page : [{ page, text }].
  extractedPages   Json?
  /// Nombre de pages (PDF) ou de feuilles (XLSX).
  pageCount        Int?
  extractionStatus String  @default("en_attente")
  extractionError  String?

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  knowledgeEntry KnowledgeEntry?
  chunks         DocumentChunk[]
  citations      Citation[]

  @@index([tenderId, scope])
  @@index([sha256])
}

/// Fragment indexé pour la recherche sémantique (RAG).
model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  ordinal    Int
  page       Int?
  heading    String?
  content    String
  /// Lexèmes normalisés, utilisés par la recherche lexicale de repli.
  tokens     String[] @default([])
  /// Vecteur d'embedding quand un fournisseur est configuré.
  embedding  Float[]  @default([])
  createdAt  DateTime @default(now())

  @@unique([documentId, ordinal])
  @@index([documentId, page])
}

enum KnowledgeCategory {
  CATALOGUE
  PROGRAMME
  INSTITUTIONNEL
  REFERENCE_CLIENT
  MEMOIRE_TECHNIQUE
  REPONSE_PRECEDENTE
  CV_FORMATEUR
  CERTIFICATION
  ATTESTATION
  QUALITE
  TARIF
  MODELE_FINANCIER
  IONIS
  PROCEDURE_INTERNE
}

model KnowledgeEntry {
  id           String            @id @default(cuid())
  documentId   String            @unique
  document     Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  category     KnowledgeCategory
  title        String
  summary      String?
  tags         String[]          @default([])
  /// Date de fin de validité : au-delà, le document est signalé obsolète.
  validUntil   DateTime?
  obsolete     Boolean           @default(false)
  /// Connaissance vérifiée par un humain.
  validated    Boolean           @default(false)
  validatedBy  String?
  validatedAt  DateTime?
  /// Rôles autorisés à lire ce document.
  allowedRoles Role[]            @default([])
  confidential Boolean           @default(false)
  version      Int               @default(1)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([category, obsolete])
}

/// Rattache une information restituée par la plateforme à sa source documentaire.
model Citation {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  page       Int?
  quote      String?
  /// Entité citée : "analysis", "requirement", "responseDocument"…
  targetType String
  targetId   String

  @@index([targetType, targetId])
}

// ---------------------------------------------------------------------------
// Analyse du DCE
// ---------------------------------------------------------------------------

model TenderAnalysis {
  id       String @id @default(cuid())
  tenderId String @unique
  tender   Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  /// Moteur ayant produit l'analyse : "deterministe" ou "ia:<modele>".
  engine           String  @default("deterministe")
  /// Vrai uniquement si au moins une pièce du DCE a été analysée.
  basedOnDocuments Boolean @default(false)
  documentCount    Int     @default(0)

  objet                  String?
  besoin                 String?
  publics                String[] @default([])
  stagiaires             String?
  sessions               String?
  volumeHoraire          String?
  modalites              String[] @default([])
  lieux                  String[] @default([])
  moyensHumains          String?
  certifications         String[] @default([])
  exigencesAdmin         String[] @default([])
  /// Critères d'attribution : [{ label, weight, source }].
  criteres               Json?
  contraintesFinancieres String?
  delais                 String?
  risques                String[] @default([])
  penalites              String[] @default([])
  obligations            String[] @default([])
  /// Contradictions relevées entre pièces : [{ sujet, piecesConcernees[], detail }].
  contradictions         Json?
  /// Points à clarifier auprès de l'acheteur.
  pointsAClarifier       String[] @default([])
  /// Incertitudes explicites du moteur — jamais masquées.
  incertitudes           String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RequirementLevel {
  /// Non-respect potentiellement éliminatoire.
  OBLIGATOIRE
  /// Entre dans les critères de notation.
  EVALUEE
  /// Amélioration possible, non imposée.
  RECOMMANDATION
}

enum RequirementStatus {
  CONFORME
  A_VERIFIER
  MANQUANT
  NON_CONFORME
  NON_APPLICABLE
}

model Requirement {
  id       String @id @default(cuid())
  tenderId String
  tender   Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  level            RequirementLevel
  status           RequirementStatus @default(A_VERIFIER)
  label            String
  detail           String?
  /// Rubrique : "administratif", "technique", "financier", "qualite"…
  category         String?
  /// Pièce du DCE qui porte l'exigence.
  sourceDocumentId String?
  sourcePage       Int?
  sourceQuote      String?
  /// Pondération quand l'exigence est un critère noté.
  weight           Float?
  /// Commentaire de l'utilisateur qui statue.
  reviewNote       String?
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([tenderId, level])
}

// ---------------------------------------------------------------------------
// Matching
// ---------------------------------------------------------------------------

/// Nature de la consultation, évaluée indépendamment des domaines du catalogue.
///
/// Le catalogue sert à affiner le matching, pas à délimiter le périmètre :
/// l'ESME intervient sur l'ensemble de la formation continue professionnelle.
/// La seule exclusion est l'apprentissage d'un métier manuel étranger à son
/// champ — esthétique, coiffure, métiers de bouche, métiers du bâtiment.
enum TenderNature {
  /// Formation, dans un domaine couvert par le catalogue ESME.
  FORMATION_CATALOGUE
  /// Formation, dans un domaine voisin ou mobilisable via le Groupe IONIS.
  FORMATION_VOISINE
  /// Formation hors catalogue, mais dans le champ d'intervention de l'ESME.
  FORMATION_REALISABLE
  /// Apprentissage d'un métier manuel hors du champ de l'ESME.
  FORMATION_METIER_MANUEL
  /// Le marché ne paraît pas porter sur de la formation.
  HORS_CHAMP
}

model MatchResult {
  id       String @id @default(cuid())
  tenderId String @unique
  tender   Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  /// La consultation porte-t-elle sur de la formation professionnelle ?
  isFormation      Boolean      @default(false)
  /// Indices ayant fondé cette conclusion.
  formationSignals String[]     @default([])
  nature           TenderNature @default(HORS_CHAMP)
  /// Appréciation en clair, affichée sur l'affaire.
  natureLabel      String?

  /// Score A — adéquation au catalogue ESME, sur 100.
  scoreCatalogue Float @default(0)
  /// Score B — formations voisines / sur mesure, sur 100.
  scoreVoisines  Float @default(0)
  /// Score C — compétences du Groupe IONIS, sur 100.
  scoreIonis     Float @default(0)
  scoreGlobal    Float @default(0)

  /// Pondération appliquée lors du calcul.
  weights Json?
  engine  String @default("deterministe")

  coveredSkills  String[] @default([])
  missingSkills  String[] @default([])
  adaptableNote  String?
  ionisNote      String?
  extraResources String[] @default([])
  constraints    String[] @default([])
  recommendation String?
  /// Limites explicites du calcul.
  caveats        String[] @default([])
  /// Score ajusté à la main par un utilisateur.
  manualOverride Boolean  @default(false)
  overrideNote   String?

  /// Qualification humaine d'une absence de correspondance.
  ///
  /// Le moteur classe ; l'humain tranche et dit pourquoi. Sans cette trace,
  /// une consultation écartée ne se distingue pas d'une consultation jamais
  /// regardée, et la même erreur d'appréciation se répète d'une année sur
  /// l'autre.
  noMatchReason NoMatchReason?
  /// Motif libre, obligatoire lorsque le motif retenu est « Autre ».
  noMatchNote   String?
  noMatchAt     DateTime?

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  matches TrainingMatch[]
}

model TrainingMatch {
  id            String      @id @default(cuid())
  matchResultId String
  matchResult   MatchResult @relation(fields: [matchResultId], references: [id], onDelete: Cascade)
  trainingId    String
  training      Training    @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  score     Float
  /// Termes qui ont déclenché la correspondance.
  signals   String[] @default([])
  covered   String[] @default([])
  rationale String?

  @@unique([matchResultId, trainingId])
  @@index([matchResultId, score])
}

// ---------------------------------------------------------------------------
// Décision Go / No Go
// ---------------------------------------------------------------------------

enum NoGoReason {
  HORS_PERIMETRE
  MOYENS_INSUFFISANTS
  RENTABILITE_INSUFFISANTE
  DELAI_TROP_COURT
  EXIGENCE_ELIMINATOIRE
  RISQUE_CONTRACTUEL
  DECISION_STRATEGIQUE
  CONCURRENCE_DEFAVORABLE
  REFERENCES_INSUFFISANTES
  CERTIFICATION_MANQUANTE
  ZONE_GEOGRAPHIQUE
  VOLUME_INSUFFISANT
  PLAN_DE_CHARGE
  AUTRE
}

/// Pourquoi une consultation n'a pas été retenue au matching.
///
/// Distinct du motif de No Go : celui-ci porte sur l'adéquation de l'objet,
/// pas sur l'opportunité de répondre. Une consultation peut très bien
/// correspondre au catalogue et faire l'objet d'un No Go, ou l'inverse.
enum NoMatchReason {
  HORS_FORMATION
  METIER_MANUEL
  DOMAINE_NON_COUVERT
  FORMATION_INITIALE
  PUBLIC_INADAPTE
  VOLUME_INSUFFISANT
  OBJET_TROP_IMPRECIS
  SCORE_TROP_FAIBLE
  AUTRE
}

model Decision {
  id       String @id @default(cuid())
  tenderId String
  tender   Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  status           GoNoGoStatus
  reason           NoGoReason?
  rationale        String?
  /// Lots sur lesquels l'établissement se positionne, pour une décision GO.
  ///
  /// Un accord-cadre allotit souvent des besoins très différents : se
  /// positionner sur la totalité n'a presque jamais de sens. Vide lorsque la
  /// consultation ne comporte pas de lots, ou lorsque la décision porte sur
  /// l'ensemble.
  lotIds           String[]     @default([])
  /// Libellés figés au moment de la décision.
  ///
  /// Un lot peut être renommé, ou l'affaire rechargée depuis un rectificatif :
  /// l'historique doit rester lisible sans dépendre de l'état actuel des lots.
  lotLabels        String[]     @default([])
  /// Recommandation produite par le moteur avant arbitrage humain.
  aiRecommendation String?
  aiConfidence     Float?
  /// Critères pesés : [{ critere, appreciation, poids }].
  criteria         Json?

  decidedById String?
  decidedBy   User?    @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime @default(now())
  /// Décision annulée par une réouverture ultérieure.
  superseded  Boolean  @default(false)

  @@index([tenderId, decidedAt])
}

// ---------------------------------------------------------------------------
// Préparation de la réponse
// ---------------------------------------------------------------------------

enum TaskStatus {
  A_FAIRE
  EN_COURS
  EN_RELECTURE
  TERMINEE
  BLOQUEE
}

model Task {
  id       String @id @default(cuid())
  tenderId String
  tender   Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  title      String
  detail     String?
  status     TaskStatus @default(A_FAIRE)
  dueAt      DateTime?
  position   Int        @default(0)
  assigneeId String?
  assignee   User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([tenderId, status])
}

model Assignment {
  id        String   @id @default(cuid())
  tenderId  String
  tender    Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Rôle sur l'affaire : "pilote", "redacteur", "relecteur", "expert".
  role      String
  createdAt DateTime @default(now())

  @@unique([tenderId, userId, role])
}

/// Pièce attendue au dossier, suivie jusqu'à la validation.
model ChecklistItem {
  id       String @id @default(cuid())
  tenderId String
  tender   Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  label              String
  detail             String?
  /// "administratif", "technique", "financier".
  category           String            @default("administratif")
  mandatory          Boolean           @default(true)
  status             RequirementStatus @default(MANQUANT)
  /// Document de réponse qui satisfait la pièce.
  responseDocumentId String?
  note               String?
  position           Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([tenderId, category])
}

enum ResponseDocStatus {
  BROUILLON
  EN_REDACTION
  EN_RELECTURE
  VALIDE
}

enum ResponseDocType {
  MEMOIRE_TECHNIQUE
  DC1
  DC2
  DC4
  ACTE_ENGAGEMENT
  ANNEXE_ADMIN
  QUESTIONNAIRE
  CADRE_REPONSE
  OFFRE_FINANCIERE
  AUTRE
}

/// Document produit par ESME, éditable et versionné.
model ResponseDocument {
  id       String @id @default(cuid())
  tenderId String
  tender   Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  type                  ResponseDocType   @default(AUTRE)
  title                 String
  status                ResponseDocStatus @default(BROUILLON)
  /// Contenu structuré : [{ id, heading, body, origin, citations[], todo }].
  content               Json?
  /// Champs à compléter signalés par le moteur, jamais inventés.
  gaps                  String[]          @default([])
  /// Cadre imposé par l'acheteur à respecter.
  imposedFrameworkDocId String?
  version               Int               @default(1)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  versions DocumentVersion[]
  comments DocumentComment[]

  @@index([tenderId, type])
}

model DocumentVersion {
  id         String           @id @default(cuid())
  documentId String
  document   ResponseDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version    Int
  content    Json
  label      String?
  authorId   String?
  author     User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt  DateTime         @default(now())

  @@unique([documentId, version])
}

model DocumentComment {
  id         String           @id @default(cuid())
  documentId String
  document   ResponseDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// Section visée dans le contenu structuré.
  sectionId  String?
  authorId   String?
  author     User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body       String
  /// Proposition de réécriture soumise à validation.
  suggestion String?
  resolved   Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([documentId, resolved])
}

/// Ligne de l'offre financière (BPU / DQE / DPGF).
model PricingLine {
  id       String @id @default(cuid())
  tenderId String
  tender   Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  label       String
  unit        String?
  quantity    Decimal? @db.Decimal(12, 3)
  /// Coûts : laissés vides tant que la donnée réelle n'est pas fournie.
  costPedago  Decimal? @db.Decimal(12, 2)
  costTrainer Decimal? @db.Decimal(12, 2)
  costOther   Decimal? @db.Decimal(12, 2)
  unitPrice   Decimal? @db.Decimal(12, 2)
  marginRate  Float?
  /// Source du prix : "referentiel", "saisie", "bpu_acheteur".
  priceOrigin String   @default("saisie")
  note        String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenderId])
}

/// Référentiel de tarifs interne, alimenté par l'administration.
model PriceReference {
  id         String    @id @default(cuid())
  label      String
  unit       String
  amountEur  Decimal   @db.Decimal(12, 2)
  domain     String?
  note       String?
  validFrom  DateTime?
  validUntil DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Contrôle de complétude, de qualité et de conformité
// ---------------------------------------------------------------------------

model QualityReview {
  id       String @id @default(cuid())
  tenderId String
  tender   Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  engine       String  @default("deterministe")
  /// Score de complétude sur 100.
  completeness Float   @default(0)
  /// Score de qualité rédactionnelle et méthodologique sur 100.
  quality      Float   @default(0)
  /// Score de conformité aux exigences impératives sur 100.
  compliance   Float   @default(0)
  /// Alertes bloquantes : pièce obligatoire manquante, non-conformité éliminatoire.
  blockers     Json?
  /// Détail par rubrique : [{ rubrique, note, commentaire }].
  breakdown    Json?
  /// Corrections proposées : [{ probleme, risque, correction, documentCible, applique }].
  corrections  Json?
  notes        String?

  createdAt DateTime @default(now())

  @@index([tenderId, createdAt])
}

// ---------------------------------------------------------------------------
// Dépôt, négociation, résultat
// ---------------------------------------------------------------------------

model Submission {
  id       String @id @default(cuid())
  tenderId String @unique
  tender   Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  /// Le dépôt n'est enregistré qu'avec une confirmation humaine explicite.
  confirmed            Boolean   @default(false)
  submittedAt          DateTime?
  platform             String?
  submittedBy          String?
  platformRef          String?
  /// Référence ou fichier de l'accusé de réception.
  acknowledgement      String?
  acknowledgementDocId String?
  documentList         String[]  @default([])
  observations         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

enum NegotiationKind {
  DEMANDE_PRECISION
  REUNION
  QUESTION_ACHETEUR
  DOCUMENT_COMPLEMENTAIRE
  OFFRE_REVISEE
  VERSION_MEMOIRE
  AUTRE
}

model NegotiationItem {
  id       String @id @default(cuid())
  tenderId String
  tender   Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  kind       NegotiationKind @default(AUTRE)
  title      String
  detail     String?
  dueAt      DateTime?
  happenedAt DateTime?
  done       Boolean         @default(false)
  assigneeId String?
  assignee   User?           @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([tenderId, dueAt])
}

model TenderResult {
  id       String @id @default(cuid())
  tenderId String @unique
  tender   Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  status OutcomeStatus @default(EN_ATTENTE)

  // Marché attribué
  awardedLot       String?
  awardedAmountEur Decimal?  @db.Decimal(14, 2)
  notifiedAt       DateTime?
  contractDuration String?
  startsAt         DateTime?
  operationalOwner String?

  // Marché rejeté
  rejectionReason String?
  ranking         Int?
  technicalScore  Float?
  financialScore  Float?
  globalScore     Float?
  winner          String?
  winnerAmountEur Decimal? @db.Decimal(14, 2)
  gapAnalysis     String?
  /// Enseignements réutilisables pour les futures réponses.
  lessons         String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Alertes et notifications
// ---------------------------------------------------------------------------

enum NotificationKind {
  NOUVELLE_CONSULTATION
  DCE_DISPONIBLE
  DCE_NON_RECUPERE
  AVIS_RECTIFICATIF
  DATE_LIMITE_MODIFIEE
  GO_NO_GO_A_DECIDER
  DOCUMENT_MANQUANT
  VALIDATION_ATTENDUE
  ECHEANCE_DEPOT
  DEMANDE_NEGOCIATION
  RESULTAT_PUBLIE
}

enum NotificationSeverity {
  INFO
  IMPORTANT
  CRITIQUE
}

model Notification {
  id        String               @id @default(cuid())
  kind      NotificationKind
  severity  NotificationSeverity @default(INFO)
  title     String
  body      String?
  tenderId  String?
  tender    Tender?              @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  /// Échéance associée, pour les rappels J-15 à J-0.
  dueAt     DateTime?
  createdAt DateTime             @default(now())

  @@index([userId, readAt])
  @@index([tenderId, createdAt])
}

// ---------------------------------------------------------------------------
// Paramétrage
// ---------------------------------------------------------------------------

/// Réglages d'administration : marque, pondérations, étapes du pipeline, rappels.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}
