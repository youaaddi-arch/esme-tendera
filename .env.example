# Base de données PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tendera?schema=public"

# Secret de signature des sessions (à régénérer en production : openssl rand -base64 48)
AUTH_SECRET=""

# Moteur IA (optionnel). Sans clé, TENDERA bascule sur le moteur déterministe local.
# ANTHROPIC_API_KEY=""
TENDERA_AI_MODEL="claude-sonnet-5-5"

# Stockage documentaire local (chemin absolu ou relatif au projet)
TENDERA_STORAGE_DIR="./storage"

# Jeton de la synchronisation quotidienne de veille (openssl rand -hex 32)
TENDERA_CRON_SECRET=""
