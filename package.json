    "docx": "^9.5.1",
    "jose": "^6.1.0",
    "lucide-react": "^0.552.0",
    "mammoth": "^1.11.0",
    "next": "16.4.3",
    "pdfjs-dist": "^4.10.38",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.7",
